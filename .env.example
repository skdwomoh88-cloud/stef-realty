NODE_ENV=development
PORT=5000

MONGO_URI=mongodb+srv://username:password@cluster.example/database
MONGO_SERVER_SELECTION_TIMEOUT_MS=10000

JWT_SECRET=replace-with-a-long-random-secret
JWT_EXPIRES_IN=7d

# Comma-separated production frontend origins. Localhost origins are added only outside production.
CORS_ORIGINS=

# Number of trusted reverse-proxy hops. Leave unset for direct internet-facing deployments.
TRUST_PROXY_HOPS=

AUTH_LOGIN_RATE_LIMIT_WINDOW_MS=900000
AUTH_LOGIN_RATE_LIMIT_MAX=10
AUTH_REGISTER_RATE_LIMIT_WINDOW_MS=3600000
AUTH_REGISTER_RATE_LIMIT_MAX=5
AUTH_FORGOT_PASSWORD_RATE_LIMIT_WINDOW_MS=3600000
AUTH_FORGOT_PASSWORD_RATE_LIMIT_MAX=5
AUTH_RESET_PASSWORD_RATE_LIMIT_WINDOW_MS=900000
AUTH_RESET_PASSWORD_RATE_LIMIT_MAX=10

# Password reset links and Resend transactional delivery.
FRONTEND_URL=http://localhost:5173
PASSWORD_RESET_TOKEN_EXPIRES_MINUTES=30
RESEND_API_KEY=
PASSWORD_RESET_FROM_EMAIL=Stef Realty <no-reply@your-verified-domain.example>

JSON_BODY_LIMIT=2mb
URLENCODED_BODY_LIMIT=2mb
MAX_UPLOAD_FILE_SIZE_MB=5
MAX_UPLOAD_FILES=10

# Private document files. Never expose this directory through express.static.
PRIVATE_DOCUMENT_UPLOAD_DIR=private-uploads/documents
MAX_DOCUMENT_FILE_SIZE_MB=10

FEEDBACK_TOKEN_EXPIRES_DAYS=7
